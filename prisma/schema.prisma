generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Vercel's Neon integration created these under a NEON_ prefix because a
  // stale DATABASE_URL (Prisma Postgres) already occupied that name.
  // url must be the pooled host for serverless; migrations need a direct
  // connection, which is what directUrl provides.
  url       = env("NEON_DATABASE_URL")
  directUrl = env("NEON_DATABASE_URL_UNPOOLED")
}

model Insight {
  id          String    @id @default(cuid())
  productArea String
  theme       String
  persona     String?
  oneLiner    String
  content     String
  client      String?
  sourceName  String?
  sourceUrl   String?
  sourceType  String    @default("SHEET")
  date        DateTime?
  wtp         String?
  tags        String    @default("[]")
  // Email of the signed-in user who added this entry. Nullable because the 230
  // seeded rows predate auth and have no author.
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  comments    Comment[]

  @@index([productArea])
  @@index([client])
  @@index([theme])
}

model Comment {
  id        String   @id @default(cuid())
  insightId String
  // Email of the author; only they may edit or delete the comment.
  author    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  insight   Insight  @relation(fields: [insightId], references: [id], onDelete: Cascade)

  @@index([insightId])
}

model DiscoveryQuestion {
  id          String    @id @default(cuid())
  productArea String
  theme       String
  persona     String?
  question    String
  notesIntent String?
  source      String?
  createdAt   DateTime  @default(now())

  @@index([productArea])
  @@index([theme])
}

model SourceDocument {
  id          String    @id @default(cuid())
  name        String
  productArea String
  date        DateTime?
  format      String?
  topics      String?
  link        String?
  notes       String?
  createdAt   DateTime  @default(now())
}
