generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Vercel's Neon integration created these under a NEON_ prefix because a
  // stale DATABASE_URL (Prisma Postgres) already occupied that name.
  // url must be the pooled host for serverless; migrations need a direct
  // connection, which is what directUrl provides.
  url       = env("NEON_DATABASE_URL")
  directUrl = env("NEON_DATABASE_URL_UNPOOLED")
}

model Insight {
  id           String    @id @default(cuid())
  /// One entry can touch several areas ("Risk Adjustment" and "Coders" both, say),
  /// so this is a Postgres text array rather than a single value. Queried with
  /// hasSome. Discovery questions and source documents stay single-area.
  productAreas String[]
  theme        String
  persona      String?
  oneLiner     String
  content      String
  client       String?
  sourceName   String?
  sourceUrl    String?
  sourceType   String    @default("SHEET")
  date         DateTime?
  wtp          String?
  // The free-text client this row arrived with, kept when the value was remapped
  // onto a canonical Account — so a bad match can be traced back and redone.
  clientRaw    String?
  tags         String    @default("[]")
  // Email of the signed-in user who added this entry. Nullable because the 230
  // seeded rows predate auth and have no author.
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  comments Comment[]

  @@index([client])
  @@index([theme])
}

/// The canonical client list. Client was free text until Aug 2026, which split
/// "DTC", "DTC — Lynn" and "DTC Family Health" into three clients everywhere.
model Account {
  id        String   @id
  name      String   @unique
  /// JSON array of alternative spellings that resolve here. Never displayed.
  aliases   String   @default("[]")
  /// Email of whoever added it from the UI; null for the seeded list.
  createdBy String?
  createdAt DateTime @default(now())

  // Everything below is a snapshot of Navina's Salesforce accounts report
  // (2026-08-18), which covered active direct accounts only. An account outside
  // that filter keeps its nulls, and /clients renders those as "-".
  /// "Green" | "Yellow" | "Red".
  health         String?
  /// JSON array of live product names, e.g. ["Risk","Quality","HIE"].
  products       String    @default("[]")
  ehr            String?
  /// "Physician Group" | "ACO/MSO" | "Health System" | "Health Plan".
  segment        String?
  billingState   String?
  accountOwner   String?
  csmName        String?
  hieMembers     Int?
  qualityMembers Int?
  riskMembers    Int?
  /// Current ARR and contracted ARR, in whole dollars.
  arr            Int?
  carr           Int?
  renewalDate    DateTime?
  lastActivityAt DateTime?
  firstClosedWon DateTime?
  /// Go-live date. Not in the report - entered by hand from the client panel.
  liveDate       DateTime?
}

model Comment {
  id        String   @id @default(cuid())
  insightId String
  // Email of the author; only they may edit or delete the comment.
  author    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  insight Insight @relation(fields: [insightId], references: [id], onDelete: Cascade)

  @@index([insightId])
}

model DiscoveryQuestion {
  id          String   @id @default(cuid())
  productArea String
  theme       String
  persona     String?
  question    String
  notesIntent String?
  source      String?
  // Email of the signed-in user who added this. Nullable: seeded rows predate auth.
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([productArea])
  @@index([theme])
}

model SourceDocument {
  id          String    @id @default(cuid())
  name        String
  productArea String
  date        DateTime?
  format      String?
  topics      String?
  link        String?
  notes       String?
  // Email of the signed-in user who added this. Nullable: seeded rows predate auth.
  createdBy   String?
  createdAt   DateTime  @default(now())
}

model Event {
  id        String   @id @default(cuid())
  /// Email of the signed-in user, or "anonymous" if a request slips past auth.
  actor     String
  /// Dotted action name, e.g. "feedback.created", "ai.extract", "page.view".
  action    String
  /// Entity id for record actions, or the path for page views.
  target    String?
  /// Human-readable context so the log is readable without joining.
  label     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actor])
  @@index([action])
}

/// A feature idea reported by someone inside the org — distinct from Insight,
/// which is feedback gathered from clients. Status is a plain string, like every
/// other status-shaped field in this schema, with the valid set documented in
/// src/lib/feature-request-status.ts rather than as a Postgres enum.
model FeatureRequest {
  id          String   @id @default(cuid())
  title       String
  /// Markdown. May contain [text](url) links and ![alt](url) images — rendered,
  /// never as raw HTML, so a pasted link can't inject markup.
  description String
  painToSolve String
  /// Email of whoever filed it. Only this address, or the hub owner
  /// (src/lib/people.ts), may edit or delete the row.
  reporter    String
  status      String   @default("New")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([reporter])
  @@index([status])
}

/// One tracked competitor, sourced from the "CI Launcher" tool's public data
/// (its own UI requires a Navina Google login, but the underlying data was
/// served to any browser regardless — flagged to that tool's owner separately).
model Competitor {
  id        String   @id @default(cuid())
  name      String   @unique
  /// Top-level grouping, matching CI Launcher's own sidebar. Validated
  /// against COMPETITOR_CATEGORIES in src/lib/competitor-categories.ts,
  /// not a Postgres enum — same convention as Account.health, FeatureRequest.status.
  category  String
  /// Second-level grouping, only used inside "HCC / Risk Adj." ("Pop Health",
  /// "Ambient Scribes"). Null for every other category and for the direct,
  /// ungrouped entries inside HCC / Risk Adj. itself.
  subgroup  String?
  /// CI Launcher's own free-text positioning line, e.g. "Ambient AI / Clinical
  /// Documentation" — more granular than `category`, shown as a subtitle.
  positioning     String?
  website         String?
  /// A paragraph description. From CI Launcher's data, not written here.
  overview        String?
  /// Bullet-point facts (funding, headcount, product angle). Markdown-ish
  /// plain text with leading "– " bullets, rendered as-is.
  keyFacts        String?
  /// How CI Launcher's own notes frame this competitor against Navina.
  differentiation String?
  /// When CI Launcher's own data was last updated, not when we imported it.
  lastUpdated     DateTime?
  /// Mirrors CI Launcher's own ordering within a category/subgroup; null sorts last.
  sortOrder Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sources   CompetitorSource[]
  documents CompetitorDocument[]

  @@index([category])
}

/// A link (Drive/Notion/etc.) pulled from CI Launcher for one competitor.
/// `type` comes straight from that tool's own data (e.g. "notion", "folder",
/// "battlecard") rather than being re-derived from the URL.
model CompetitorSource {
  id           String   @id @default(cuid())
  competitorId String
  label        String
  url          String
  type         String
  createdAt    DateTime @default(now())

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId])
}

/// The text behind a CompetitorSource link, read once and stored.
///
/// A CompetitorSource is only a URL — the hub knew a battlecard existed but not
/// a word of what it said. This is what a fetch of that link produced, so the
/// ask can quote competitor material without reaching out to Drive or Notion at
/// question time.
///
/// Rows are written for failures and skips too, not just successes. Coverage is
/// the point: a service account will reach some of these files and not others,
/// and "we read 61 of 73" is only knowable if the 12 misses are recorded.
model CompetitorDocument {
  id           String  @id @default(cuid())
  competitorId String
  /// The link this was reached through. Null when the link was a folder and the
  /// document was found inside it — those have no CompetitorSource of their own.
  sourceId     String?
  /// The id at the origin: a Drive file id or a Notion page id. A re-read
  /// updates the row it wrote last time instead of adding a second copy.
  externalId   String
  /// "notion" | "drive"
  origin       String
  title        String
  url          String
  mimeType     String?

  /// Cleaned but otherwise verbatim, with expiring image URLs stripped. Kept as
  /// the audit trail behind `summary` — when someone disputes an answer, this is
  /// what the summary was made from.
  text    String?
  /// Condensed prose written for the ask to read. See lib/ingest/condense.ts for
  /// why the raw text is not what gets quoted.
  summary String?

  /// "internal" when the document carries Navina sales strategy, privately
  /// gathered competitor pricing, named clients or personnel notes; "external"
  /// when it only describes the competitor. Decides what may leave the hub in a
  /// briefing pack. Recorded on ingest so that decision never needs a re-read.
  sensitivity       String?
  /// One phrase naming what made it internal. Null when external.
  sensitivityReason String?

  /// "ok" | "empty" | "skipped" | "failed"
  status String
  /// Why it failed or was skipped, and what a partial read missed. Null on a
  /// clean success.
  note   String?
  /// The origin reported content it would not expand — an embedded deck, a
  /// synced block. The summary is real but incomplete.
  truncated Boolean @default(false)

  /// Last modified at the origin, when it reports one. Not when we read it:
  /// Innovaccer's hub record said June 2025 while its Notion page had been
  /// edited three weeks ago, and only the origin's date reveals that.
  sourceUpdatedAt DateTime?
  fetchedAt       DateTime  @default(now())
  /// The condense prompt version behind `summary`, so a bad batch is traceable.
  condenseVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, externalId])
  @@index([competitorId])
  @@index([status])
  @@index([sensitivity])
}

/// One question asked of "Ask the feedback", with the answer it got.
///
/// Deliberately not an Event row: an Event is a fire-and-forget line in a log
/// that also holds every page view, while a Q&A pair has a life after it is
/// written — it gets rated, read by other people, and replayed when the prompt
/// changes.
model AskLog {
  id            String    @id @default(cuid())
  /// Email of whoever asked. Shown only to the hub owner (see lib/people.ts):
  /// the page is shared so the team can learn from past questions, and people
  /// ask differently when their name is attached.
  actor         String
  question      String
  answer        String
  /// JSON array of the insight ids the answer cited.
  sourceIds     String    @default("[]")
  /// How many insights the search fed to Claude. 0 vs 15 separates "the search
  /// never found the right rows" from "it had them and still answered badly" —
  /// two failure modes with opposite fixes.
  matchedCount  Int
  model         String
  /// Bumped whenever the QA system prompt changes, so a bad rating can always be
  /// traced back to the prompt that produced it.
  promptVersion String
  latencyMs     Int?
  /// "up" | "down". Null means nobody has judged it yet.
  rating        String?
  /// What was wrong with the answer. The thumb alone is barely actionable; this
  /// is the part that tells you what to change.
  ratingNote    String?
  ratedBy       String?
  ratedAt       DateTime?
  createdAt     DateTime  @default(now())

  @@index([createdAt])
  @@index([rating])
}
