generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Vercel's Neon integration created these under a NEON_ prefix because a
  // stale DATABASE_URL (Prisma Postgres) already occupied that name.
  // url must be the pooled host for serverless; migrations need a direct
  // connection, which is what directUrl provides.
  url       = env("NEON_DATABASE_URL")
  directUrl = env("NEON_DATABASE_URL_UNPOOLED")
}

model Insight {
  id          String    @id @default(cuid())
  productArea String
  theme       String
  persona     String?
  oneLiner    String
  content     String
  client      String?
  sourceName  String?
  sourceUrl   String?
  sourceType  String    @default("SHEET")
  date        DateTime?
  wtp         String?
  // The free-text client this row arrived with, kept when the value was remapped
  // onto a canonical Account — so a bad match can be traced back and redone.
  clientRaw   String?
  tags        String    @default("[]")
  // Email of the signed-in user who added this entry. Nullable because the 230
  // seeded rows predate auth and have no author.
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  comments Comment[]

  @@index([productArea])
  @@index([client])
  @@index([theme])
}

/// The canonical client list. Client was free text until Aug 2026, which split
/// "DTC", "DTC — Lynn" and "DTC Family Health" into three clients everywhere.
model Account {
  id        String   @id
  name      String   @unique
  /// JSON array of alternative spellings that resolve here. Never displayed.
  aliases   String   @default("[]")
  /// Email of whoever added it from the UI; null for the seeded list.
  createdBy String?
  createdAt DateTime @default(now())

  // Everything below is a snapshot of Navina's Salesforce accounts report
  // (2026-08-18), which covered active direct accounts only. An account outside
  // that filter keeps its nulls, and /clients renders those as "-".
  /// "Green" | "Yellow" | "Red".
  health         String?
  /// JSON array of live product names, e.g. ["Risk","Quality","HIE"].
  products       String    @default("[]")
  ehr            String?
  /// "Physician Group" | "ACO/MSO" | "Health System" | "Health Plan".
  segment        String?
  billingState   String?
  accountOwner   String?
  csmName        String?
  hieMembers     Int?
  qualityMembers Int?
  riskMembers    Int?
  /// Current ARR and contracted ARR, in whole dollars.
  arr            Int?
  carr           Int?
  renewalDate    DateTime?
  lastActivityAt DateTime?
  firstClosedWon DateTime?
  /// Go-live date. Not in the report - entered by hand from the client panel.
  liveDate       DateTime?
}

model Comment {
  id        String   @id @default(cuid())
  insightId String
  // Email of the author; only they may edit or delete the comment.
  author    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  insight Insight @relation(fields: [insightId], references: [id], onDelete: Cascade)

  @@index([insightId])
}

model DiscoveryQuestion {
  id          String   @id @default(cuid())
  productArea String
  theme       String
  persona     String?
  question    String
  notesIntent String?
  source      String?
  // Email of the signed-in user who added this. Nullable: seeded rows predate auth.
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([productArea])
  @@index([theme])
}

model SourceDocument {
  id          String    @id @default(cuid())
  name        String
  productArea String
  date        DateTime?
  format      String?
  topics      String?
  link        String?
  notes       String?
  // Email of the signed-in user who added this. Nullable: seeded rows predate auth.
  createdBy   String?
  createdAt   DateTime  @default(now())
}

model Event {
  id        String   @id @default(cuid())
  /// Email of the signed-in user, or "anonymous" if a request slips past auth.
  actor     String
  /// Dotted action name, e.g. "feedback.created", "ai.extract", "page.view".
  action    String
  /// Entity id for record actions, or the path for page views.
  target    String?
  /// Human-readable context so the log is readable without joining.
  label     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actor])
  @@index([action])
}

/// One question asked of "Ask the feedback", with the answer it got.
///
/// Deliberately not an Event row: an Event is a fire-and-forget line in a log
/// that also holds every page view, while a Q&A pair has a life after it is
/// written — it gets rated, read by other people, and replayed when the prompt
/// changes.
model AskLog {
  id        String @id @default(cuid())
  /// Email of whoever asked. Shown only to the hub owner (see lib/people.ts):
  /// the page is shared so the team can learn from past questions, and people
  /// ask differently when their name is attached.
  actor     String
  question  String
  answer    String
  /// JSON array of the insight ids the answer cited.
  sourceIds String @default("[]")
  /// How many insights the search fed to Claude. 0 vs 15 separates "the search
  /// never found the right rows" from "it had them and still answered badly" —
  /// two failure modes with opposite fixes.
  matchedCount  Int
  model         String
  /// Bumped whenever the QA system prompt changes, so a bad rating can always be
  /// traced back to the prompt that produced it.
  promptVersion String
  latencyMs     Int?
  /// "up" | "down". Null means nobody has judged it yet.
  rating     String?
  /// What was wrong with the answer. The thumb alone is barely actionable; this
  /// is the part that tells you what to change.
  ratingNote String?
  ratedBy    String?
  ratedAt    DateTime?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([rating])
}
